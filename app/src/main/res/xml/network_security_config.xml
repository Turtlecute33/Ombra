<?xml version="1.0" encoding="utf-8"?>
<!-- Kotlin makes no network calls; the Rust core has its own TLS stack and ignores this file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
