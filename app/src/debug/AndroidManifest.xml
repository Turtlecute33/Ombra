<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Debug builds stop at the first bad memory access (MTE sync); release uses async. -->
    <application
        android:memtagMode="sync"
        tools:replace="android:memtagMode">
        <!-- Debug builds only: StatePushProbeTest receives large state pushes from this process. -->
        <service
            android:name=".vpn.StatePushProbe"
            android:exported="false"
            android:process=":probe" />
    </application>
</manifest>
